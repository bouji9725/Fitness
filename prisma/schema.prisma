generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  passwordHash String
  name         String             @default("")
  createdAt    DateTime           @default(now())
  profile      UserProfile?
  nutrition    NutritionSummary?
  bodyStats    BodyStatsEntry[]
  workouts     WorkoutSession[]
}

// id is the same as User.id (1-to-1, PK = FK)
model UserProfile {
  id                  String  @id
  user                User    @relation(fields: [id], references: [id])
  name                String  @default("")
  age                 Int?
  heightCm            Float?
  goal                String?
  coachSharingEnabled Boolean @default(false)
  coachName           String?
}

model BodyStatsEntry {
  id             String  @id
  userId         String
  user           User    @relation(fields: [userId], references: [id])
  date           String
  weightKg       Float
  bodyFatPercent Float
  muscleMassKg   Float?
  notes          String?
}

// id is the same as User.id (1-to-1, PK = FK)
model NutritionSummary {
  id                 String @id
  user               User   @relation(fields: [id], references: [id])
  fatFreeMassKg      Float
  fatFreeMassLbs     Float
  proteinFactor      Float
  proteinTargetGrams Float
  calorieTarget      Float
  fatPercent         Float
  fatTargetGrams     Float
  carbsTargetGrams   Float
  proteinCalories    Float
  fatCalories        Float
  carbCalories       Float
}

// exercises is stored as a JSON string (SessionExercise[]).
// This avoids a three-table join while keeping the API boundary identical.
model WorkoutSession {
  id           String                @id
  userId       String
  user         User                  @relation(fields: [userId], references: [id])
  templateId   String
  templateName String
  performedAt  String
  status       String                @default("draft")
  exercises    String
  createdAt    String
  updatedAt    String
  record       WorkoutSessionRecord?
}

model WorkoutSessionRecord {
  id        String         @id @default(cuid())
  sessionId String         @unique
  session   WorkoutSession @relation(fields: [sessionId], references: [id])
  savedAt   String
}
