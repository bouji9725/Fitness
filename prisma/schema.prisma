generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String
  name                 String                @default("")
  createdAt            DateTime              @default(now())
  profile              UserProfile?
  nutrition            NutritionSummary?
  bodyStats            BodyStatsEntry[]
  inBodyEntries        InBodyEntry[]
  progressPhotos       ProgressPhoto[]
  workouts             WorkoutSession[]
  workoutTemplates     UserWorkoutTemplate[]
  mealPreference       MealPreference?
  mealLogs             MealLogEntry[]
  dailyTargetOverrides DailyTargetOverride[]
}

// id is the same as User.id (1-to-1, PK = FK)
model UserProfile {
  id                  String  @id
  user                User    @relation(fields: [id], references: [id])
  name                String  @default("")
  sex                 String?
  age                 Int?
  heightCm            Float?
  goal                String?
  coachSharingEnabled Boolean @default(false)
  coachName           String?
}

model BodyStatsEntry {
  id             String  @id
  userId         String
  user           User    @relation(fields: [userId], references: [id])
  date           String
  weightKg       Float
  bodyFatPercent Float
  muscleMassKg   Float?
  notes          String?
}

// id is the same as User.id (1-to-1, PK = FK)
model NutritionSummary {
  id                 String @id
  user               User   @relation(fields: [id], references: [id])
  fatFreeMassKg      Float
  fatFreeMassLbs     Float
  proteinFactor      Float
  proteinTargetGrams Float
  calorieTarget      Float
  fatPercent         Float
  fatTargetGrams     Float
  carbsTargetGrams   Float
  proteinCalories    Float
  fatCalories        Float
  carbCalories       Float
}

model WorkoutSession {
  id           String                   @id
  userId       String
  user         User                     @relation(fields: [userId], references: [id])
  templateId   String
  templateName String
  performedAt  String
  status       String                   @default("draft")
  notes        String?
  createdAt    String
  updatedAt    String
  record       WorkoutSessionRecord?
  exercises    WorkoutSessionExercise[]
}

model WorkoutSessionRecord {
  id        String         @id @default(cuid())
  sessionId String         @unique
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  savedAt   String
}

model WorkoutSessionExercise {
  id                 String         @id
  sessionId          String
  session            WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  templateExerciseId String?
  name               String
  muscleGroup        String
  isCompleted        Boolean        @default(false)
  previousBestReps   Float?
  previousBestWeight Float?
  order              Int
  sets               WorkoutSet[]
}

model WorkoutSet {
  id         String                 @id
  exerciseId String
  exercise   WorkoutSessionExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  reps       Int?
  weight     Float?
  completed  Boolean                @default(false)
  order      Int
}

// id is the same as User.id (1-to-1, PK = FK)
model MealPreference {
  id                 String  @id
  user               User    @relation(fields: [id], references: [id])
  structure          String
  dayType            String
  workoutTime        String?
  fastingWindowStart String?
}

model MealLogEntry {
  id           String  @id
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  date         String
  slotIndex    Int
  calories     Float
  proteinGrams Float
  carbsGrams   Float
  fatGrams     Float
  notes        String?
}

model InBodyEntry {
  id                   String  @id
  userId               String
  user                 User    @relation(fields: [userId], references: [id])
  date                 String
  weightKg             Float
  bodyFatPercent       Float
  skeletalMuscleMassKg Float?
  fatFreeMassKg        Float?
  notes                String?
}

model ProgressPhoto {
  id       String  @id
  userId   String
  user     User    @relation(fields: [userId], references: [id])
  date     String
  imageUrl String
  label    String?
}

model UserWorkoutTemplate {
  id        String @id
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  name      String
  exercises String // JSON: ExerciseTemplate[]
  createdAt String
}

model DailyTargetOverride {
  id           String  @id
  userId       String
  user         User    @relation(fields: [userId], references: [id])
  date         String
  calories     Float?
  proteinGrams Float?
  carbsGrams   Float?
  fatGrams     Float?

  @@unique([userId, date])
}

model ExerciseLibrary {
  id               String   @id
  name             String
  category         String
  level            String
  equipment        String?
  force            String?
  mechanic         String?
  primaryMuscles   String[]
  secondaryMuscles String[]
  muscleGroupTag   String
  instructions     String[]
  images           String[]
}
