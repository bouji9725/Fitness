# ── Database (Neon PostgreSQL) ────────────────────────────────────────────────
# Pooled connection — used by the app at runtime (goes through Neon's PgBouncer)
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct connection — used by Prisma migrations (bypasses the pooler)
# Same credentials as DATABASE_URL, just remove "-pooler" from the hostname
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

# ── Auth ──────────────────────────────────────────────────────────────────────
# Random secret for JWT signing — generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"

# ── File Storage (Vercel Blob) ────────────────────────────────────────────────
# Progress photos are stored in Vercel Blob
# Get from vercel.com → project → Storage → Blob → env.local → copy BLOB_READ_WRITE_TOKEN
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# ── Rate Limiting (Upstash Redis) ─────────────────────────────────────────────
# Redis for rate limiting on auth routes
# Get from console.upstash.com → database → REST API
UPSTASH_REDIS_REST_URL="https://..."
UPSTASH_REDIS_REST_TOKEN="..."

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Transactional email service — password reset, welcome emails, etc.
# Get API key from resend.com → API Keys
RESEND_API_KEY="re_..."

# Email sender address — use "onboarding@resend.dev" for testing,
# or your verified domain in production (e.g., noreply@yourdomain.com)
RESEND_EMAIL_FROM="onboarding@resend.dev"
